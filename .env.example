# FloodSense-AI Environment Configuration
# Copy this file to .env and configure credentials for live external providers.
# All features operate with offline/hybrid fallbacks if credentials are left blank.

# Copernicus Data Space Ecosystem (CDSE)
# Register free at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Optional Google Earth Engine (GEE)
# Register at: https://earthengine.google.com/noncommercial/
GEE_PROJECT_ID=floodsense-ai-capstone

# NASA Earthdata (for GPM IMERG & SRTM DEM)
# Register free at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Gemini API (for Automated NDRF SitRep generation)
# Free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# System Operating Mode: live | offline | hybrid
DATA_MODE=hybrid
CACHE_ENABLED=true
