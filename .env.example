# =============================================================================
# FLOODSENSE-AI: ZERO-COST REMOTE SENSING CONFIGURATION ENVIRONMENT
# =============================================================================
# Strict Zero-Cost Academic Policy:
# All services below utilize free non-commercial / open-data tiers.
# NEVER commit real credentials, private keys, or tokens to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. European Space Agency (ESA) Copernicus Data Space Ecosystem (CDSE)
# -----------------------------------------------------------------------------
# Register free at: https://dataspace.copernicus.eu/
# Navigate to: User Dashboard -> API Settings -> OAuth2 Client Credentials
# Option A: OAuth2 Client Credentials (Recommended for API integration)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Option B: CDSE User Credentials (Alternative)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# -----------------------------------------------------------------------------
# 2. Google Earth Engine (GEE) Python API
# -----------------------------------------------------------------------------
# Register free academic account at: https://earthengine.google.com/
# Create a free Google Cloud project with Earth Engine API enabled.
# Authenticate on CLI with: `earthengine authenticate`
# Or configure Service Account credentials:
GEE_PROJECT_ID=ee-disaster-response-ai
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=

# -----------------------------------------------------------------------------
# 3. Data Acquisition Mode & Offline Caching
# -----------------------------------------------------------------------------
# Modes:
#   LIVE    - Query and stream live Sentinel-1/2 products via CDSE / GEE.
#   HYBRID  - Query live providers; fall back to verified local genuine cache when offline.
#   OFFLINE - Run 100% locally from cached genuine regional satellite datasets.
DATA_MODE=HYBRID
CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# 4. Hardware Acceleration
# -----------------------------------------------------------------------------
# Leave empty for automatic hardware detection:
#   - NVIDIA GeForce RTX 4070 Laptop GPU (CUDA) when available
#   - CPU Engine (PyTorch Optimized) as fallback
DEVICE=auto

# -----------------------------------------------------------------------------
# 5. Local Storage Directories (Relative to backend/ or absolute paths)
# -----------------------------------------------------------------------------
SATELLITE_CACHE_DIR=backend/data/satellite_cache
DEM_CACHE_DIR=backend/data/dem_cache
OSM_CACHE_DIR=backend/data/osm_cache
METADATA_DIR=backend/data/metadata
DOWNLOADS_DIR=backend/data/downloads
